# Copy to .env.local for Next.js. The public catalog and browser tools require
# no secrets. Leave unused keys blank and keep real credentials out of Git.

# Peptide Agent. Set at least one provider key to enable /api/chat.
# Failover order: Venice → xAI Grok → Anthropic → published references when
# configured models fail to produce an answer. Unconfigured providers are skipped.
VENICE_API_KEY=
XAI_API_KEY=
# Also needed for /api/analyze-peptide, LLM fact QA, and the eval judge.
ANTHROPIC_API_KEY=

# Optional provider overrides. Values shown in comments are code defaults.
# VENICE_BASE_URL=https://api.venice.ai/api/v1
# VENICE_MODEL=qwen-3-6-plus
# VENICE_TOOLS=off                 # Grounding tools enabled by default.
# VENICE_DISABLE_THINKING=1       # Off by default.
# GROK_BASE_URL=https://api.x.ai/v1
# GROK_MODELS=grok-4.3,grok-4.7    # Tried in order.
# GROK_TOOLS=off                   # Grounding tools enabled by default.
# AGENT_MODEL=claude-opus-4-8      # Anthropic chain adds Opus 4.8 and Sonnet 4.6, deduplicated.
# AGENT_EFFORT=medium              # Chat reasoning effort: low, medium, high, max.
# AGENT_DEBUG=1                    # Chat debug logging is off by default.

# Optional free-use limits. Days reset at midnight UTC.
# AGENT_FREE_DAILY=5               # Per visitor, per route.
# AGENT_IP_DAILY_MAX=15            # Defaults to 3 × AGENT_FREE_DAILY, at least the visitor limit.
# AGENT_DAILY_CEILING=1200         # Site-wide free model runs across chat and analysis.
# AGENT_QUOTA=off                  # Disables visitor/IP quotas only. Enabled by default.
# Automation/eval bypass sent as x-agent-key. Falls back to ADMIN_SECRET.
AGENT_BYPASS_KEY=

# Research Pass. Stripe is required to enable checkout. Use a test key in
# previews and a restricted key with Checkout Sessions read/write in production.
STRIPE_SECRET_KEY=
# STRIPE_API_BASE=https://api.stripe.com
# AGENT_PASS_PRICE_CENTS=1500      # $15.00 for the default 30-day pass.
# AGENT_PASS_DAYS=30
# AGENT_PASS_DAILY_MAX=200         # Per pass, per UTC day.

# Set both in production for shared limits, quotas, metering, API keys, and lookup
# caching. With either missing, storage is per-process and production logs a warning.
# During a Redis outage, rate limiting and lookup caching can use local storage.
# Quota reservations fail closed when the configured store errors.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Required to enable production admin APIs. CRON_SECRET is the fallback.
# Both accept Authorization: Bearer <secret> on their respective routes.
ADMIN_SECRET=
# Required to enable scheduled production jobs, including /api/jobs/fact-qa.
CRON_SECRET=

# Optional referral postback secrets. Uppercase the vendor ID and replace
# non-alphanumerics with underscores. Each partner uses its own HMAC secret.
# REFERRAL_POSTBACK_SECRET_AMINO_CLUB=

# Optional public build-time settings. Rebuild after changing them.
NEXT_PUBLIC_GA_ID=
# Set to android only for the Play/TWA build, which hides affiliate surfaces.
# Unset selects the regular web build.
NEXT_PUBLIC_PLATFORM=
# Digital Asset Links for Android. Fingerprints are comma-separated SHA-256
# signing certificates. Required for verified app links on the TWA host.
# ANDROID_PACKAGE_NAME=com.americanpeptide.calculator
ANDROID_SHA256_FINGERPRINTS=
# Set to https://americanpeptide.net only when that production redirect host is
# attached. Unset keeps outbound /go links on the current origin.
NEXT_PUBLIC_REDIRECT_ORIGIN=
# NEXT_PUBLIC_CONTACT_EMAIL=contact@americanpeptide.com
# NEXT_PUBLIC_PRIVACY_EMAIL=privacy@americanpeptide.com
# If privacy email is unset it uses the contact override, if provided.

# CLI and test settings. Export them in the shell for standalone scripts.
# ORG_DIR=../american-peptide-org  # Default is the sibling checkout.
# GSC_SITE_URL=                    # Required for npm run gsc unless passed as an argument.
# GSC_SA_KEY_FILE=                 # Required for npm run gsc. Path to service-account JSON.
# CATALOG_SMOKE_ORIGIN=http://localhost:3000
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=  # Otherwise use Playwright's Chromium.
# CATALOG_REPORT_COMPLETENESS=1   # Optional report during tests. Off by default.
# NODE_ENV, VITEST, GITHUB_STEP_SUMMARY, and the screenshot server PORT are
# supplied by Next.js, Vitest, GitHub Actions, or the script itself.
