# Copy this file to .env.local and fill in real values.
# Never commit .env.local to version control.

# ── Peptide Agent providers (/api/chat) ──────────────────────────────────────
# The research agent runs a two-tier provider ladder: Venice (uncensored) is the
# PRIMARY, the Anthropic chain is the reasoning BACKUP, and our published
# reference content is the model-free floor. Configure at least one provider.

# Venice AI — PRIMARY. Uncensored, OpenAI-compatible; answers the dosing/protocol
# research questions Claude's policy layer refuses. Get a key at https://venice.ai
# (Settings → API — prefer an inference-scoped key over an admin key).
VENICE_API_KEY=your_venice_api_key_here
# Optional. Base URL (no trailing slash) — override only for a proxy/gateway.
VENICE_BASE_URL=https://api.venice.ai/api/v1
# Optional. Model id. MUST be an uncensored model that reliably emits real tool
# calls on tool_choice:'auto', or the grounding layer silently breaks. Verified
# good: qwen-3-8-27b (recommended), gemma-4-uncensored (no reasoning-starvation
# risk), olafangensan-glm-4.7-flash-heretic. AVOID venice-uncensored-1-2: it is
# the most uncensored but NARRATES tool use as prose instead of calling tools.
# List capabilities via GET {VENICE_BASE_URL}/models?type=text.
VENICE_MODEL=qwen-3-8-27b
# Optional. Set to "off" to stop sending grounding tools to Venice (use only if
# you switch to a model that does not support function calling).
VENICE_TOOLS=
# Optional. Set to "1" to suppress reasoning tokens on thinking models (e.g. qwen)
# so a long chain-of-thought can't starve the visible answer to empty.
VENICE_DISABLE_THINKING=

# Anthropic API key — BACKUP for /api/chat, and required for the structured
# routes (/api/analyze-peptide, /api/jobs/fact-qa) and the eval judge.
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Google Analytics (optional) ──────────────────────────────────────────────
# GA4 Measurement ID, e.g. "G-XXXXXXXXXX". When set, Google Analytics loads
# site-wide (via @next/third-parties) alongside Vercel Analytics. Leave unset in
# local dev / previews so GA only tracks production. NEXT_PUBLIC_ prefix is
# required (the ID is used client-side and is not secret).
NEXT_PUBLIC_GA_ID=

# ── Rate limiting (/api/chat, /api/analyze-peptide) ──────────────────────────
# OPTIONAL but recommended in production. Without these, the limiter falls back
# to an in-memory counter that is per-instance only — on multi-instance/
# serverless deploys (e.g. Vercel) it under-counts. Set both to enforce limits
# durably across instances via Upstash Redis (REST; no extra dependency).
# Create a free database at https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── API keys + usage metering (/api/keys, /api/catalog, /api/mcp) ────────────
# API keys and per-key usage counters are stored in the same Upstash Redis as
# the rate limiter (above). REQUIRED in production for durable keys — without
# Upstash, keys live in-memory only (per-instance, lost on cold start) and the
# issuance endpoint flags persistent:false. No separate config needed beyond
# the UPSTASH_REDIS_REST_* vars above.

# Secret protecting the GET /api/admin/* endpoints: /api/admin/usage (the "who
# uses what" dashboard data) and /api/admin/referrals (aggregate affiliate-click
# counts from the /go redirect). Sent as `Authorization: Bearer <secret>`. Falls
# back to CRON_SECRET if unset. REQUIRED in production for those endpoints; may be
# unset in local dev. Generate one: `openssl rand -hex 32`.
ADMIN_SECRET=

# ── Scheduled jobs (/api/jobs/*) ─────────────────────────────────────────────
# Shared secret for cron-triggered jobs (e.g. the overnight fact-QA at
# /api/jobs/fact-qa). Vercel Cron sends it as `Authorization: Bearer <secret>`.
# REQUIRED in production — the job refuses to run unauthenticated there. In local
# dev it may be left unset. Generate one: `openssl rand -hex 32`.
CRON_SECRET=

# ── Waitlist (/api/waitlist) — Resend ────────────────────────────────────────
# All optional: without RESEND_API_KEY the endpoint logs signups and still
# returns success, so dev works with no setup.
#
# API key from https://resend.com/api-keys
RESEND_API_KEY=
# Default audience (https://resend.com/audiences) every signup is added to.
RESEND_AUDIENCE_ID=
# Optional: supplier signups go to this audience instead, if set.
RESEND_AUDIENCE_SUPPLIER_ID=
# From address for the confirmation email. Domain must be verified in Resend.
# e.g. "AmericanPeptide <waitlist@americanpeptide.com>"
RESEND_FROM=
# Optional: internal address that receives a full-detail signup notification
# (preserves role + source, which Resend audiences don't store).
WAITLIST_NOTIFY=
