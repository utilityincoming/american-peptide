# Copy this file to .env.local and fill in real values.
# Never commit .env.local to version control.

# ── Peptide Agent providers (/api/chat) ──────────────────────────────────────
# The research agent runs a provider ladder ordered by cost per search: Venice
# (uncensored, cheapest) is the PRIMARY, xAI Grok the FAILOVER, the Anthropic
# chain the reasoning BACKUP, and our published reference content the model-free
# floor. Configure at least one provider; unset rungs are skipped.

# Venice AI — PRIMARY. Uncensored, OpenAI-compatible; answers the dosing/protocol
# research questions Claude's policy layer refuses. Get a key at https://venice.ai
# (Settings → API — prefer an inference-scoped key over an admin key).
VENICE_API_KEY=your_venice_api_key_here
# Optional. Base URL (no trailing slash) — override only for a proxy/gateway.
VENICE_BASE_URL=https://api.venice.ai/api/v1
# Optional. Model id. MUST be an uncensored model that reliably emits real tool
# calls on tool_choice:'auto', or the grounding layer silently breaks. Verified
# good: qwen-3-8-27b (recommended), gemma-4-uncensored (no reasoning-starvation
# risk), olafangensan-glm-4.7-flash-heretic. AVOID venice-uncensored-1-2: it is
# the most uncensored but NARRATES tool use as prose instead of calling tools.
# List capabilities via GET {VENICE_BASE_URL}/models?type=text.
VENICE_MODEL=qwen-3-8-27b
# Optional. Set to "off" to stop sending grounding tools to Venice (use only if
# you switch to a model that does not support function calling).
VENICE_TOOLS=
# Optional. Set to "1" to suppress reasoning tokens on thinking models (e.g. qwen)
# so a long chain-of-thought can't starve the visible answer to empty.
VENICE_DISABLE_THINKING=

# xAI Grok — FAILOVER, tried after Venice and before Anthropic because it costs
# less per search than Claude. OpenAI-compatible. Leave unset to skip this rung.
# Get a key at https://console.x.ai/
XAI_API_KEY=
# Optional. Comma-separated model ids tried in order — keep the CHEAPEST first.
# Ids and prices change; confirm both at https://docs.x.ai/docs/models. A wrong
# or retired id just fails over to the next one.
GROK_MODELS=grok-4.3,grok-4.7
# Optional. Base URL (no trailing slash) — override only for a proxy/gateway.
GROK_BASE_URL=https://api.x.ai/v1
# Optional. Set to "off" to stop sending grounding tools to Grok.
GROK_TOOLS=

# Anthropic API key — BACKUP for /api/chat, and required for the structured
# routes (/api/analyze-peptide, /api/jobs/fact-qa) and the eval judge.
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Agent free allowance + spend safeguards (/api/chat, /api/analyze-peptide) ─
# All OPTIONAL; the defaults below apply when unset. Counters live in Upstash
# (see "Rate limiting"); without it they are per-instance only and do not hold
# on serverless. If the store errors, the routes fail CLOSED: no model is called
# and visitors get reference content instead.
#
# Free uses per visitor per UTC WEEK (per route; resets Monday 00:00 UTC).
# Returns HTTP 402 with the Research Pass offer when spent.
AGENT_FREE_WEEKLY=5
# Hard cap per IP address per week (per route) — the bound that holds when a
# client discards the visitor cookie. Default: 3x AGENT_FREE_WEEKLY.
AGENT_IP_WEEKLY_MAX=15
# Site-wide ceiling on FREE model runs per UTC day, across all visitors and both
# routes (Research Pass runs are not counted against it). Your maximum daily spend is roughly this x your cost per run. Once
# hit, the agent serves model-free reference content until midnight UTC.
AGENT_DAILY_CEILING=300
# Set to "off" to disable the per-visitor/IP allowance (the ceiling still applies).
AGENT_QUOTA=
# Secret for automation (npm run eval) and owner testing: sent as the
# `x-agent-key` header it skips the browser-origin check and the free allowance
# (still counted against the ceiling and metered). Falls back to ADMIN_SECRET.
AGENT_BYPASS_KEY=

# ── Research Pass (paid tier: /research/pass, /api/pass/*) ───────────────────
# The paid option is offered only when STRIPE_SECRET_KEY is set; until then the
# site shows the free weekly allowance alone. Use a RESTRICTED key limited to
# Checkout Sessions (write + read) — https://dashboard.stripe.com/apikeys
# Use an sk_test_ key on previews to try the flow with Stripe test cards.
STRIPE_SECRET_KEY=
# One-time price in cents and the term it buys. Defaults: $29.99 for 30 days.
AGENT_PASS_PRICE_CENTS=2999
AGENT_PASS_DAYS=30
# Fair-use guard: max runs per pass per UTC day, so a shared code can't run up
# an unbounded bill.
AGENT_PASS_DAILY_MAX=200

# ── Google Analytics (optional) ──────────────────────────────────────────────
# GA4 Measurement ID, e.g. "G-XXXXXXXXXX". When set, Google Analytics loads
# site-wide (via @next/third-parties) alongside Vercel Analytics. Leave unset in
# local dev / previews so GA only tracks production. NEXT_PUBLIC_ prefix is
# required (the ID is used client-side and is not secret).
NEXT_PUBLIC_GA_ID=

# ── Outbound redirect host (affiliate/community link routing) ────────────────
# OPTIONAL. The dedicated outbound-redirect origin (americanpeptide.net) that
# every /go/<id> affiliate + community anchor is rendered onto, so commercial
# outbound leaves through .net and the editorial americanpeptide.com domain's
# outbound link profile stays clean. middleware.ts keeps .net serving nothing
# but /go (every other path 308s to the .com canonical).
#
# Leave UNSET (the default) on local dev and previews — links stay same-origin
# /go/<id> paths, exactly as if .net didn't exist, which is safe before .net is
# attached. Set it ONLY in the production environment, to the full origin with
# no trailing slash, then redeploy (NEXT_PUBLIC_* is inlined at build time, so a
# rebuild is required for the anchors to flip onto .net):
#
#     NEXT_PUBLIC_REDIRECT_ORIGIN=https://americanpeptide.net
NEXT_PUBLIC_REDIRECT_ORIGIN=

# ── Rate limiting (/api/chat, /api/analyze-peptide) ──────────────────────────
# OPTIONAL but recommended in production. Without these, the limiter falls back
# to an in-memory counter that is per-instance only — on multi-instance/
# serverless deploys (e.g. Vercel) it under-counts. Set both to enforce limits
# durably across instances via Upstash Redis (REST; no extra dependency).
# Create a free database at https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── API keys + usage metering (/api/keys, /api/catalog, /api/mcp) ────────────
# API keys and per-key usage counters are stored in the same Upstash Redis as
# the rate limiter (above). REQUIRED in production for durable keys — without
# Upstash, keys live in-memory only (per-instance, lost on cold start) and the
# issuance endpoint flags persistent:false. No separate config needed beyond
# the UPSTASH_REDIS_REST_* vars above.

# Secret protecting the GET /api/admin/* endpoints: /api/admin/usage (the "who
# uses what" dashboard data) and /api/admin/referrals (aggregate affiliate-click
# counts from the /go redirect). Sent as `Authorization: Bearer <secret>`. Falls
# back to CRON_SECRET if unset. REQUIRED in production for those endpoints; may be
# unset in local dev. Generate one: `openssl rand -hex 32`.
ADMIN_SECRET=

# ── Scheduled jobs (/api/jobs/*) ─────────────────────────────────────────────
# Shared secret for cron-triggered jobs (e.g. the overnight fact-QA at
# /api/jobs/fact-qa). Vercel Cron sends it as `Authorization: Bearer <secret>`.
# REQUIRED in production — the job refuses to run unauthenticated there. In local
# dev it may be left unset. Generate one: `openssl rand -hex 32`.
CRON_SECRET=
